COMPOSE_PROJECT_NAME=lab-ai

# Open WebUI
OPENWEBUI_PORT=3000
WEBUI_SECRET_KEY=change-to-a-long-random-string
ENABLE_SIGNUP=true
RAG_TOP_K=5

# LiteLLM
LITELLM_PORT=4000
LITELLM_MASTER_KEY=change-to-a-strong-key

# Provider API keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Shared embedding alias
EMBEDDING_MODEL=lab-embedding

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_API_KEY=

# kb-index metadata
KNOWLEDGE_LOGICAL_ROOT=labknowledge://
# filesystem-knowledge-bridge MCP
KNOWLEDGE_READ_MCP_PORT=8000
KNOWLEDGE_REGISTER_MCP_PORT=8001
# Dockerサービス名やリバースプロキシ名を変更した場合は合わせて変更
KNOWLEDGE_READ_MCP_ALLOWED_HOSTS=knowledge-read-mcp:8000,localhost:8000,127.0.0.1:8000
KNOWLEDGE_REGISTER_MCP_ALLOWED_HOSTS=knowledge-register-mcp:8001,localhost:8001,127.0.0.1:8001
KNOWLEDGE_HOST_ROOT=/mnt/knowledge
KNOWLEDGE_INCOMING_HOST_ROOT=/mnt/knowledge-incoming
