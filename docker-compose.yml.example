services:
  open-webui:
    image: ghcr.io/open-webui/open-webui:v0.10.2
    container_name: open-webui
    ports:
      - "${OPENWEBUI_PORT:-3000}:8080"
    volumes:
      - ./open-webui:/app/backend/data
    environment:
      OPENAI_API_BASE_URL: http://litellm:4000/v1
      OPENAI_API_KEY: ${LITELLM_MASTER_KEY}
      RAG_EMBEDDING_ENGINE: openai
      RAG_OPENAI_API_BASE_URL: http://litellm:4000/v1
      RAG_OPENAI_API_KEY: ${LITELLM_MASTER_KEY}
      RAG_EMBEDDING_MODEL: ${EMBEDDING_MODEL}
      WEBUI_SECRET_KEY: ${WEBUI_SECRET_KEY}
      ENABLE_SIGNUP: ${ENABLE_SIGNUP:-true}
      RAG_TOP_K: ${RAG_TOP_K:-5}
      ENABLE_FORWARD_USER_INFO_HEADERS: "true"
    depends_on:
      - litellm
      - qdrant
    restart: unless-stopped

  knowledge-read-mcp:
    build: .
    command: kb-read-mcp
    ports:
      - "127.0.0.1:${KB_READ_MCP_PORT:-8000}:8000"
    environment: &knowledge-env
      QDRANT_URL: http://qdrant:6333
      QDRANT_API_KEY: ${QDRANT_API_KEY:-}
      LITELLM_API_BASE: http://litellm:4000/v1
      LITELLM_API_KEY: ${LITELLM_MASTER_KEY}
      EMBEDDING_MODEL: ${EMBEDDING_MODEL}
      KNOWLEDGE_ROOT: /knowledge
      KNOWLEDGE_LOGICAL_ROOT: ${KNOWLEDGE_LOGICAL_ROOT:-labknowledge://}
    volumes:
      - ${KNOWLEDGE_HOST_PATH:-/mnt/knowledge}:/knowledge:ro
    depends_on:
      - litellm
      - qdrant
    restart: unless-stopped

  knowledge-register-mcp:
    build: .
    command: kb-register-mcp
    ports:
      - "127.0.0.1:${KB_REGISTER_MCP_PORT:-8001}:8001"
    environment:
      <<: *knowledge-env
      INCOMING_ROOT: /incoming
    volumes:
      - ${KNOWLEDGE_HOST_PATH:-/mnt/knowledge}:/knowledge:rw
      - ${INCOMING_HOST_PATH:-/mnt/knowledge-incoming}:/incoming:ro
    depends_on:
      - litellm
      - qdrant
    restart: unless-stopped

  litellm:
    image: ghcr.io/berriai/litellm:main-latest
    container_name: litellm
    ports:
      - "127.0.0.1:${LITELLM_PORT:-4000}:4000"
    volumes:
      - ./litellm/config.yaml:/app/config.yaml:ro
    command:
      - "--config=/app/config.yaml"
    env_file:
      - .env
    depends_on:
      - tei
    restart: unless-stopped

  qdrant:
    image: qdrant/qdrant:v1.17.0
    container_name: qdrant
    ports:
      - "127.0.0.1:${QDRANT_HTTP_PORT:-6333}:6333"
    volumes:
      - qdrant_data:/qdrant/storage
    restart: unless-stopped

  tei:
    image: ghcr.io/huggingface/text-embeddings-inference:cuda-1.9
    container_name: tei
    command:
      - --model-id
      - BAAI/bge-m3
      - --max-batch-tokens
      - "4096"
      - --max-client-batch-size
      - "16"
      - --auto-truncate
    volumes:
      - hf_cache:/data
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    restart: unless-stopped

volumes:
  qdrant_data:
  hf_cache:
